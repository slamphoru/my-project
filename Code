# ---------- [10] Парсер и апдейт ----------
# Регулярки для батареи (и отдельной строкой, и в составе основной)
vb_re  = re.compile(r'(?:VBAT|Vbat)\s*[:=]\s*([0-9]+(?:\.[0-9]+)?)', re.IGNORECASE)
soc_re = re.compile(r'(?:SOC)\s*[:=]\s*([0-9]+(?:\.[0-9]+)?)', re.IGNORECASE)
pct_re = re.compile(r'([0-9]+(?:\.[0-9]+)?)\s*%')
st1_re = re.compile(r'(?:STATE)\s*[:=]\s*([A-Za-z]+)', re.IGNORECASE)
st2_re = re.compile(r'\[([A-Za-z]+)\]')

def parse_main_line(line):
    """Возвращает (ax,ay,az,gx,gy,gz,kg, vbat,soc,state) или None"""
    if not line.startswith("Accel"): return None
    parts=[p.strip() for p in line.split("|")]
    ax=ay=az=gx=gy=gz=None; kg=None; vbat=None; soc=None; state=None
    for p in parts:
        pl=p.lower()
        if pl.startswith("accel"):
            vec=p.split(":",1)[1].strip(); ax,ay,az=[float(x) for x in vec.strip(" ()").split(",")]
        elif pl.startswith("gyro"):
            vec=p.split(":",1)[1].strip(); gx,gy,gz=[float(x) for x in vec.strip(" ()").split(",")]
        elif pl.startswith("kg"):
            try: kg=float(p.split(":",1)[1].strip())
            except: pass
        else:
            m=vb_re.search(p);   vbat = float(m.group(1)) if (m and vbat is None) else vbat
            m=soc_re.search(p);  soc  = float(m.group(1)) if (m and soc  is None) else soc
            m=pct_re.search(p);  soc  = float(m.group(1)) if (m and soc  is None) else soc
            m=st1_re.search(p);  state= m.group(1)        if (m and state is None) else state
            m=st2_re.search(p);  state= m.group(1)        if (m and state is None) else state
    if None in (ax,ay,az,gx,gy,gz): return None
    return ax,ay,az,gx,gy,gz,kg,vbat,soc,state

def parse_battery_line(line):
    """Парсит *отдельную* строку батареи. Возвращает (vbat,soc,state) или None."""
    L=line.lower()
    if ("vbat" in L) or ("soc" in L) or (("%" in L) and ("v" in L)):
        vbat=soc=state=None
        m=vb_re.search(line);  vbat = float(m.group(1)) if m else None
        m=soc_re.search(line); soc  = float(m.group(1)) if m else None
        if soc is None:
            m=pct_re.search(line); soc = float(m.group(1)) if m else None
        m=st1_re.search(line); state = m.group(1) if m else None
        if state is None:
            m=st2_re.search(line); state = m.group(1) if m else None
        if (vbat is not None) or (soc is not None) or (state is not None):
            return vbat,soc,state
    return None

def update(dt):
    global last_ts, bx, by, bz, q_ref, yaw_zero, roll_zero, pitch_zero
    global calib_active, calib_t, cal_gx, cal_gy, cal_gz, cal_n
    global gx_dps_glob, gy_dps_glob, gz_dps_glob, gmag_lpf, aerr_lpf
    global stationary_state, still_timer, settle_timer
    global force_latest, vbat_latest, soc_latest, batt_state

    line = None
    while lines: line = lines.popleft()
    if line is None: return

    # пробуем как "основную" IMU-строку
    parsed = parse_main_line(line)
    if parsed is None:
        # если это отдельная батарейная строка — просто обновим индикатор и выходим
        b = parse_battery_line(line)
        if b is not None:
            v,s,st=b
            if v is not None: vbat_latest=v
            if s is not None: soc_latest=s
            if st is not None: batt_state=st
        return

    ax, ay, az, gx_raw, gy_raw, gz_raw, kg, vbat, soc, state = parsed
    if kg   is not None: force_latest = kg
    if vbat is not None: vbat_latest  = vbat
    if soc  is not None: soc_latest   = soc
    if state is not None: batt_state  = state

    now = time.perf_counter()
    if last_ts is None:
        last_ts = now; return
    dT = now - last_ts
    last_ts = now
    if dT <= 0.0: dT = 1e-6

    # калибровка гиры по кнопке C
    if calib_active:
        calib_t += dT
        cal_gx += gx_raw; cal_gy += gy_raw; cal_gz += gz_raw; cal_n += 1
        if calib_t >= 3.0 and cal_n > 0:
            bx = cal_gx / cal_n
            by = cal_gy / cal_n
            bz = cal_gz / cal_n
            q_ref = quat_norm(ahrs.quat())
            yaw_zero = roll_zero = pitch_zero = 0.0
            calib_active = False

    # детектор покоя
    gmag = math.sqrt(gx_raw*gx_raw + gy_raw*gy_raw + gz_raw*gz_raw)
    gnorm = math.sqrt(ax*ax + ay*ay + az*az)
    aerr = abs(gnorm - 9.81)
    alpha_g = math.exp(-dT / ST_GMAG_TAU)
    alpha_a = math.exp(-dT / ST_AERR_TAU)
    gmag_lpf = alpha_g * gmag_lpf + (1 - alpha_g) * gmag
    aerr_lpf = alpha_a * aerr_lpf + (1 - alpha_a) * aerr

    if not stationary_state:
        if (gmag_lpf < ST_GMAG_THR) and (aerr_lpf < ST_AERR_THR):
            still_timer += dT
            if still_timer >= ST_DWELL_SEC:
                stationary_state = True
                settle_timer = ST_SETTLE_SEC
        else:
            still_timer = 0.0
    else:
        if (gmag_lpf >= ST_GMAG_THR*1.3) or (aerr_lpf >= ST_AERR_THR*1.3):
            stationary_state = False
            still_timer = 0.0
        else:
            still_timer += dT
            if settle_timer > 0.0:
                settle_timer -= dT
                if settle_timer < 0.0: settle_timer = 0.0

    # адаптивные биасы
    qw,qx,qy,qz = ahrs.quat()
    sinp = 2.0*(qw*qy - qz*qx)
    pitch_est = (math.copysign(math.pi/2, sinp) if abs(sinp)>=1.0 else math.asin(sinp))
    pitch_est_deg = math.degrees(pitch_est)
    _, pitch_acc_deg = accel_to_rp_deg(ax, ay, az)
    pitch_err = abs(pitch_acc_deg - pitch_est_deg)

    eta_x = (ETA_Q_X if stationary_state else ETA_M_X)
    eta_z = (ETA_Q_Z if stationary_state else ETA_M_Z)
    beta_x = 1.0 - math.exp(-eta_x * dT)
    beta_z = 1.0 - math.exp(-eta_z * dT)
    bx += beta_x * (gx_raw - bx)
    bz += beta_z * (gz_raw - bz)

    if stationary_state and (settle_timer == 0.0) and (abs(gx_raw) < AX_GUARD_XZ) and (abs(gz_raw) < AX_GUARD_XZ) and (pitch_err < PITCH_ERR_MAX):
        eta_y = ETA_Q_Y
    else:
        eta_y = ETA_M_Y_TINY
    beta_y = 1.0 - math.exp(-eta_y * dT)
    by += beta_y * (gy_raw - by)

    # мёртвые зоны
    gx_dps = gx_raw - bx; gy_dps = gy_raw - by; gz_dps = gz_raw - bz
    if abs(gx_dps)<DEADBAND_X: gx_dps=0.0
    if abs(gy_dps)<DEADBAND_Y: gy_dps=0.0
    if abs(gz_dps)<DEADBAND_Z: gz_dps=0.0
    gx_dps_glob, gy_dps_glob, gz_dps_glob = gx_dps, gy_dps, gz_dps

    # Mahony
    moving = (gmag_lpf >= ST_GMAG_THR*1.2)
    ahrs.Kp = KP_ACTIVE if moving else KP_QUIET
    ahrs.Ki = KI_BASE
    ahrs.update_imu(math.radians(gx_dps), math.radians(gy_dps), math.radians(gz_dps), ax, ay, az, dT)

    # мягкое авто-«ноль» X/Y в покое
    if stationary_state and (settle_timer == 0.0) and (still_timer >= (ST_DWELL_SEC + RECENTER_DELAY)):
        q_rel = quat_norm(quat_mul(quat_conj(q_ref), ahrs.quat()))
        r_rel, p_rel, _ = quat_to_euler_deg(q_rel)
        def approach_angle(curr, target, rate, dt):
            err = wrap_angle_deg(target - curr)
            return curr + rate * err * dt
        roll_zero  = approach_angle(roll_zero,  r_rel, RECENTER_RATE, dT)
        pitch_zero = approach_angle(pitch_zero, p_rel, RECENTER_RATE, dT)


