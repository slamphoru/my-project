def draw_cube(size=1.0, color=(0.2,0.2,1.0)):
    glColor3f(*color); s=size/2.0
    tris=[(-s,-s,-s,  s,-s,-s,  s, s,-s), (-s,-s,-s,  s, s,-s, -s, s,-s),
          (-s,-s, s,  s, s, s,  s,-s, s), (-s,-s, s, -s, s, s,  s, s, s),
          (-s,-s,-s, -s, s, s, -s, s,-s), (-s,-s,-s, -s,-s, s, -s, s, s),
          ( s,-s,-s,  s, s,-s,  s, s, s), ( s,-s,-s,  s, s, s,  s,-s, s),
          (-s, s,-s,  s, s,-s,  s, s, s), (-s, s,-s,  s, s, s, -s, s, s),
          (-s,-s,-s,  s,-s, s,  s,-s,-s), (-s,-s,-s, -s,-s, s,  s,-s, s)]
    glBegin(GL_TRIANGLES)
    for t in tris:
        glVertex3f(*t[0:3]); glVertex3f(*t[3:6]); glVertex3f(*t[6:9])
    glEnd()

def draw_cylinder(radius=0.1, length=6.0, color=(1.0,0.0,0.0), slices=24):
    glColor3f(*color); half=length/2.0; step=2.0*math.pi/slices
    glBegin(GL_TRIANGLES)
    for i in range(slices):
        a=i*step; b=(i+1)*step
        x1,z1=radius*math.cos(a),radius*math.sin(a)
        x2,z2=radius*math.cos(b),radius*math.sin(b)
        glVertex3f(x1,-half,z1); glVertex3f(x2,-half,z2); glVertex3f(x2,half,z2)
        glVertex3f(x1,-half,z1); glVertex3f(x2,half,z2); glVertex3f(x1,half,z1)
    glEnd()

def draw_disc(radius=1.2, color=(0.0,1.0,0.0), segments=64):
    glColor3f(*color)
    glBegin(GL_TRIANGLE_FAN)
    glVertex3f(0.0,0.0,0.0)
    for i in range(segments+1):
        a=2.0*math.pi*i/segments
        glVertex3f(radius*math.cos(a),0.0,radius*math.sin(a))
    glEnd()

