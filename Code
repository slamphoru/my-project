    glBegin(GL_QUADS)
    glVertex2f(bx1, by1); glVertex2f(bx2, by1); glVertex2f(bx2, by2); glVertex2f(bx1, by2)
    glEnd()
    glColor3f(0,1,0); glLineWidth(2.0)
    glBegin(GL_LINE_LOOP)
    glVertex2f(bx1, by1); glVertex2f(bx2, by1); glVertex2f(bx2, by2); glVertex2f(bx1, by2)
    glEnd()
    pause_label.text = "History: PAUSED" if HIST_PAUSED else "History: RUNNING"
    pause_label.x = (x1 + x2) * 0.5
    pause_label.y = y1 - 8
    pause_label.draw()
