# ---------- [06] История и «моторы» ----------
HIST_SEC = 10.0
hist = collections.deque()
HIST_PAUSED = False

def push_history(t, r, p, y):
    hist.append((t, r, p, y))
    t_min = t - HIST_SEC
    while hist and hist[0][0] < t_min:
        hist.popleft()

mot_hist = collections.deque()
def push_motor_history(t, m_rpm):
    mot_hist.append((t, *m_rpm))
    t_min = t - HIST_SEC
    while mot_hist and mot_hist[0][0] < t_min:
        mot_hist.popleft()

def clamp01(x): return 0.0 if x < 0.0 else (1.0 if x > 1.0 else x)

def mixer_from_angles_rpm(roll, pitch, yaw, dyn_idle_rpm):
    r = max(-1.0, min(1.0, roll  / 30.0))
    p = max(-1.0, min(1.0, pitch / 30.0))
    y = max(-1.0, min(1.0, yaw   / 90.0))
    thrust = 0.20
    kr, kp, ky = 0.12, 0.12, 0.08
    mFR = thrust + (-kp*p) + (-kr*r) + (+ky*y)
    mFL = thrust + (-kp*p) + (+kr*r) + (-ky*y)
    mRL = thrust + (+kp*p) + (+kr*r) + (+ky*y)
    mRR = thrust + (+kp*p) + (-kr*r) + (-ky*y)
    m = [clamp01(v) for v in (mFR, mFL, mRL, mRR)]
    span = max(0.0, RPM_MAX - dyn_idle_rpm)
    return [dyn_idle_rpm + (span * math.sqrt(v)) for v in m]

