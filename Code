def open_serial():
    while run_reader:
        try:
            s = serial.Serial(PREFERRED_PORT, BAUD, timeout=0)
            time.sleep(0.2); return s
        except serial.SerialException:
            time.sleep(1.0)

def serial_reader():
    global lines, lines_received, fps_data, lines_last
    ser = open_serial(); buf = ""
    while run_reader:
        try:
            chunk = ser.read(ser.in_waiting or 1).decode("utf-8", errors="ignore")
            if chunk:
                buf += chunk
                while "\n" in buf:
                    line, buf = buf.split("\n", 1)
                    line = line.strip()
                    if line:
                        lines.append(line); lines_received += 1
            else:
                time.sleep(0.001)
            now = time.time()
            if now - lines_last >= 1.0:
                fps_data = lines_received / (now - lines_last)
                lines_received = 0; lines_last = now
        except (serial.SerialException, OSError):
            try: ser.close()
            except: pass
            ser = open_serial()


