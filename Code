# ---------- [02] MahonyAHRS ----------
class MahonyAHRS:
    def __init__(self, Kp=2.2, Ki=0.05):
        self.q0, self.q1, self.q2, self.q3 = 1.0, 0.0, 0.0, 0.0
        self.Kp = Kp
        self.Ki = Ki
        self.exInt = 0.0
        self.eyInt = 0.0
        self.ezInt = 0.0

    def update_imu(self, gx, gy, gz, ax, ay, az, dt):
        norm = math.sqrt(ax*ax + ay*ay + az*az)
        if norm == 0.0:
            self._integrate(gx, gy, gz, dt); return
        ax /= norm; ay /= norm; az /= norm
        q0,q1,q2,q3 = self.q0, self.q1, self.q2, self.q3
        vx = 2.0*(q1*q3 - q0*q2)
        vy = 2.0*(q0*q1 + q2*q3)
        vz = q0*q0 - q1*q1 - q2*q2 + q3*q3
        ex = (ay*vz - az*vy)
        ey = (az*vx - ax*vz)
        ez = (ax*vy - ay*vx)
        self.exInt += ex * self.Ki * dt
        self.eyInt += ey * self.Ki * dt
        self.ezInt += ez * self.Ki * dt
        gx += self.Kp * ex + self.exInt
        gy += self.Kp * ey + self.eyInt
        gz += self.Kp * ez + self.ezInt
        self._integrate(gx, gy, gz, dt)

    def _integrate(self, gx, gy, gz, dt):
        q0,q1,q2,q3 = self.q0, self.q1, self.q2, self.q3
        qDot0 = 0.5 * (-q1*gx - q2*gy - q3*gz)
        qDot1 = 0.5 * ( q0*gx + q2*gz - q3*gy)
        qDot2 = 0.5 * ( q0*gy - q1*gz + q3*gx)
        qDot3 = 0.5 * ( q0*gz + q1*gy - q2*gx)
        q0 += qDot0 * dt; q1 += qDot1 * dt; q2 += qDot2 * dt; q3 += qDot3 * dt
        inv = 1.0 / math.sqrt(q0*q0 + q1*q1 + q2*q2 + q3*q3)
        self.q0, self.q1, self.q2, self.q3 = q0*inv, q1*inv, q2*inv, q3*inv

    def quat(self): return self.q0, self.q1, self.q2, self.q3


