            xr = 0.0 if xr < 0.0 else (1.0 if xr > 1.0 else xr)
            x = gx1 + xr * (gx2 - gx1)
            a = max(-90.0, min(90.0, ang))
            y = gy1 + (a + 90.0) / 180.0 * (gy2 - gy1)
            return x, y
        def draw_curve(idx, color):
            glColor3f(*color)
            glBegin(GL_LINE_STRIP)
            for t,r,p,y in hist:
                ang = r if idx==0 else (p if idx==1 else y)
                X,Y = to_xy(t, ang)
                glVertex2f(X, Y)
            glEnd()
        draw_curve(0, (0.0, 1.0, 0.0))
        draw_curve(1, (0.0, 0.8, 1.0))
        draw_curve(2, (1.0, 0.9, 0.1))
    btn_w, btn_h = 120, 26
    bx1 = gx1; by1 = y1 + pad; bx2 = bx1 + btn_w; by2 = by1 + btn_h
